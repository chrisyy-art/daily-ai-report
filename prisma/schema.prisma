generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Report {
  id        Int      @id @default(autoincrement())
  title     String
  /// 日报日期，格式 YYYY-MM-DD，一天一篇
  date      String   @unique
  summary   String?
  /// 正文，Markdown
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  views     ReportView[]

  @@index([published, date])
}

/// 阅读统计：每位访客每天每篇一行。阅读量 = count 之和，访客数 = 行数
model ReportView {
  id        Int      @id @default(autoincrement())
  reportId  Int
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// 匿名访客 ID（浏览器 cookie 中的随机值，不含任何个人信息）
  visitorId String
  /// 阅读日期，YYYY-MM-DD（按 REPORT_TIMEZONE）
  day       String
  /// 当天打开次数（30 分钟内重复打开只算一次）
  count     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([reportId, visitorId, day])
  @@index([day])
}
