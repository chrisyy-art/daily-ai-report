# 数据库（本地 SQLite，路径相对 prisma/schema.prisma）
DATABASE_URL="file:./dev.db"

# 管理员登录密码
ADMIN_PASSWORD="change-me"

# 用于签名 session cookie 的密钥，随便填一串足够长的随机字符串
# 可用 `openssl rand -hex 32` 生成
SESSION_SECRET="please-replace-with-a-long-random-string"

# 日报时区，用于"新建时默认今天"（可选，默认 Asia/Shanghai）
REPORT_TIMEZONE="Asia/Shanghai"
