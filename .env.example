# 数据库（本地 SQLite，路径相对 prisma/schema.prisma）
DATABASE_URL="file:./dev.db"

# 管理员登录密码
ADMIN_PASSWORD="change-me"

# 用于签名 session cookie 的密钥，随便填一串足够长的随机字符串
# 可用 `openssl rand -hex 32` 生成
SESSION_SECRET="please-replace-with-a-long-random-string"

# 日报时区，用于"新建时默认今天"（可选，默认 Asia/Shanghai）
REPORT_TIMEZONE="Asia/Shanghai"

# ICP 备案号（可选）。服务器在中国内地、备案通过后填写，会显示在页脚并链接到工信部网站
# ICP_NUMBER="京ICP备XXXXXXXX号-1"

# 前台版式（可选）：p（默认，P-Max 风格）/ light（浅色）/ dark（深色）
# READER_THEME="p"

# 站点对外地址（可选），用于分享卡片中的完整网址；默认 https://dtresearchhub.cn
# SITE_URL="https://dtresearchhub.cn"
